<!DOCTYPE html>
<html lang="en" translate="no">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>AxonHTA</title>
    <meta name="google" content="notranslate">
    <style>
        @import url("https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap");

        :root {
            color-scheme: light;
            --bg: #f4f4f4;
            --bg-elevated: #ffffff;
            --bg-soft: #f8f8f8;
            --surface-hover: #edf5ff;
            --border: #d9d9d9;
            --text: #161616;
            --text-muted: #525252;
            --accent: #0f62fe;
            --accent-strong: #0043ce;
            --accent-soft: #d0e2ff;
            --success: #198038;
            --danger: #da1e28;
            --warning: #a56f00;
            --warning-soft: #f1c21b;
            --hero-glow: radial-gradient(circle at 18% 10%, #dce7ff 0%, transparent 45%),
                radial-gradient(circle at 90% 0%, #d5ddff 0%, transparent 40%);
            --shadow: 0 20px 42px rgba(22, 22, 22, 0.08);
            --shadow-soft: 0 10px 20px rgba(22, 22, 22, 0.06);
            --transition: 180ms ease;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                color-scheme: dark;
                --bg: #161616;
                --bg-elevated: #262626;
                --bg-soft: #1f1f1f;
                --surface-hover: #393939;
                --border: #525252;
                --text: #f4f4f4;
                --text-muted: #c6c6c6;
                --accent: #78a9ff;
                --accent-strong: #a6c8ff;
                --accent-soft: #003a6d;
                --success: #42be65;
                --danger: #ff8389;
                --warning: #f1c21b;
                --warning-soft: #fddc69;
                --hero-glow: radial-gradient(circle at 18% 10%, #003a6d 0%, transparent 45%),
                    radial-gradient(circle at 90% 0%, #0043ce 0%, transparent 40%);
                --shadow: 0 24px 44px rgba(0, 0, 0, 0.38);
                --shadow-soft: 0 12px 24px rgba(0, 0, 0, 0.32);
            }
        }

        :root[data-theme="light"] {
            color-scheme: light;
            --bg: #f4f4f4;
            --bg-elevated: #ffffff;
            --bg-soft: #f8f8f8;
            --surface-hover: #edf5ff;
            --border: #d9d9d9;
            --text: #161616;
            --text-muted: #525252;
            --accent: #0f62fe;
            --accent-strong: #0043ce;
            --accent-soft: #d0e2ff;
            --success: #198038;
            --danger: #da1e28;
            --warning: #a56f00;
            --warning-soft: #f1c21b;
            --hero-glow: radial-gradient(circle at 18% 10%, #dce7ff 0%, transparent 45%),
                radial-gradient(circle at 90% 0%, #d5ddff 0%, transparent 40%);
            --shadow: 0 20px 42px rgba(22, 22, 22, 0.08);
            --shadow-soft: 0 10px 20px rgba(22, 22, 22, 0.06);
        }

        :root[data-theme="dark"] {
            color-scheme: dark;
            --bg: #161616;
            --bg-elevated: #262626;
            --bg-soft: #1f1f1f;
            --surface-hover: #393939;
            --border: #525252;
            --text: #f4f4f4;
            --text-muted: #c6c6c6;
            --accent: #78a9ff;
            --accent-strong: #a6c8ff;
            --accent-soft: #003a6d;
            --success: #42be65;
            --danger: #ff8389;
            --warning: #f1c21b;
            --warning-soft: #fddc69;
            --hero-glow: radial-gradient(circle at 18% 10%, #003a6d 0%, transparent 45%),
                radial-gradient(circle at 90% 0%, #0043ce 0%, transparent 40%);
            --shadow: 0 24px 44px rgba(0, 0, 0, 0.38);
            --shadow-soft: 0 12px 24px rgba(0, 0, 0, 0.32);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body { min-height: 100%; }

        body {
            font-family: "IBM Plex Sans", "Helvetica Neue", Helvetica, Tahoma, Arial, sans-serif;
            line-height: 1.55;
            font-size: 13px;
            color: var(--text);
            background-color: var(--bg);
            background-image: var(--hero-glow);
            background-repeat: no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 24px;
        }

        a {
            color: var(--accent);
            text-decoration: underline;
        }

        a:hover {
            color: var(--accent-strong);
            text-decoration: none;
        }

        .card {
            border: 1px solid var(--border);
            background: var(--bg-elevated);
            box-shadow: var(--shadow-soft);
            max-width: 600px;
            width: 100%;
            padding: 28px 32px 32px;
            transition: transform var(--transition), border-color var(--transition);
        }

        .card:hover {
            transform: translateY(-1px);
            border-color: var(--accent);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 16px;
            font-family: "IBM Plex Mono", Consolas, monospace;
            flex-shrink: 0;
        }

        .logo-text {
            font-size: 20px;
            font-weight: 600;
            color: var(--text);
        }

        h1 {
            font-size: clamp(1.6rem, 2.8vw, 2.15rem);
            font-weight: 700;
            border-bottom: 1px solid var(--border);
            padding-bottom: 8px;
            margin-bottom: 16px;
        }

        .subtitle {
            color: var(--text-muted);
            margin-bottom: 20px;
            line-height: 1.55;
        }

        .section-title {
            font-weight: 600;
            color: var(--text);
            border-bottom: 1px solid var(--border);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
            padding-bottom: 6px;
            margin-bottom: 14px;
            margin-top: 20px;
        }

        .section-title:first-of-type {
            margin-top: 0;
        }

        .cmd-card {
            background: var(--bg-soft);
            border: 1px solid var(--border);
            padding: 12px 14px;
            margin-bottom: 12px;
        }

        .cmd-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        code {
            font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
            padding: 1px 5px;
        }

        .cmd-block {
            font-family: "IBM Plex Mono", Consolas, "Courier New", monospace;
            font-size: 12px;
            background: var(--bg-elevated);
            border: 1px solid var(--border);
            padding: 10px 12px;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-all;
            user-select: all;
            color: var(--text);
        }

        .alert-info {
            padding: 10px 14px;
            margin: 18px 0 0;
            border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
            border-left: 3px solid var(--accent);
            background: color-mix(in srgb, var(--accent) 10%, var(--bg-elevated));
            color: var(--text);
            font-size: 13px;
            line-height: 1.55;
        }

        .alert-info strong {
            color: var(--accent-strong);
        }

        .actions-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            margin-top: 20px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.6rem 0.95rem;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            background: var(--bg-soft);
            border: 1px solid var(--border);
            color: var(--text);
            text-decoration: none;
            text-align: center;
            vertical-align: middle;
            transition: transform var(--transition), background var(--transition), border-color var(--transition);
            font-family: "IBM Plex Sans", "Segoe UI", Tahoma, Verdana, Arial, sans-serif;
        }

        .btn:hover {
            text-decoration: none;
            background: var(--surface-hover);
            transform: translateY(-1px);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn-primary {
            background: var(--accent);
            color: #fff !important;
            border-color: var(--accent);
        }

        .btn-primary:hover {
            background: var(--accent-strong);
            border-color: var(--accent-strong);
        }

        .btn-secondary {
            background: var(--bg-soft);
            color: var(--text);
            border-color: var(--border);
        }

        .pill {
            display: inline-block;
            padding: 4px 11px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            background: var(--bg-soft);
            border: 1px solid var(--border);
        }

        .pill-success {
            background: var(--success);
            color: #fff;
            border-color: var(--success);
        }
    </style>
</head>
