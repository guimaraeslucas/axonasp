# ─── Stage 1: Builder ────────────────────────────────────────────────────────
FROM golang:1.26-alpine AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION

WORKDIR /build

# Install git and xcaddy
RUN apk add --no-cache git && \
    go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest

# Cache dependency downloads separately from source
COPY go.mod go.sum ./
RUN go mod download

# Copy source tree
COPY . .

# Build Caddy with AxonASP module via xcaddy
RUN if [ -z "$VERSION" ]; then \
    PATCH=$(git rev-list --count HEAD 2>/dev/null || echo "0"); \
    REVISION=$(git rev-parse --short HEAD 2>/dev/null || echo "0"); \
    VERSION="2.3.${PATCH}.${REVISION}"; \
    fi && \
    echo "Building Caddy+AxonASP with version: ${VERSION}" && \
    cd caddy && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    xcaddy build \
    --with g3pix.com.br/axonasp/v2/caddy=. \
    --replace "g3pix.com.br/axonasp/v2=/build" \
    --replace "github.com/google/cel-go=github.com/google/cel-go@v0.20.1" && \
    ls -la caddy


# ─── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM alpine:3.21

LABEL org.opencontainers.image.title="AxonASP Caddy Edition"
LABEL org.opencontainers.image.description="AxonASP Caddy Edition - Caddy server with integrated AxonASP Classic ASP plugin. Serves ASP applications natively with automatic HTTPS."
LABEL org.opencontainers.image.url="https://g3pix.com.br/axonasp"
LABEL org.opencontainers.image.source="https://github.com/guimaraeslucas/axonasp"
LABEL org.opencontainers.image.licenses="MPL-2.0"

RUN apk add --no-cache ca-certificates tzdata su-exec && \
    update-ca-certificates && \
    addgroup -S axonasp && adduser -S axonasp -G axonasp

WORKDIR /opt/axonasp

# Copy the Caddy binary
COPY --from=builder /build/caddy/caddy ./caddy

# Copy runtime assets
COPY --from=builder /build/config/ ./config/
COPY --from=builder /build/LICENSE.txt ./LICENSE.txt
COPY --from=builder /build/www/ ./www/

# Remove test directory from www staging (strictly excluded from release)
RUN rm -rf ./www/tests/

# Copy default Caddyfile for port 8801
COPY docker/Caddyfile.caddy ./Caddyfile

# Create required runtime directories
RUN mkdir -p temp/

# Ensure correct ownership
RUN chown -R axonasp:axonasp /opt/axonasp

# Use an entrypoint that drops privileges and runs Caddy.
# Users can override the Caddyfile by mounting a volume at /opt/axonasp/Caddyfile
# or passing a custom config path as a command argument.
COPY docker/caddy-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose Caddy HTTP port (matches the default Caddyfile)
EXPOSE 8801

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8801/ > /dev/null || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["./caddy", "run", "--config", "/opt/axonasp/Caddyfile"]
